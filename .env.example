# Contact delivery:
# Option A (GoDaddy / custom domain):
# EMAIL_USER=studio@galileoandduke.com
# EMAIL_APP_PASSWORD=your_email_password
# (Automatically routes to smtpout.secureserver.net)
#
# Option B (Gmail):
# EMAIL_USER=your_gmail@gmail.com
# EMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx (16-character Google App Password)
#
# Optional custom host/port override (e.g. smtpout.secureserver.net or smtp.gmail.com):
# EMAIL_HOST=
# EMAIL_PORT=465
# EMAIL_SECURE=true
#
# Optional destination; defaults to studio@galileoandduke.com.
CONTACT_EMAIL=studio@galileoandduke.com

# Optional personal-portfolio integrations.
